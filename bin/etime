prog="$1"
pid=$$

if [[ "$prog" == "" ]] ; then
  ps -o etime
else 

  p=`pidof "$prog"`

  for x in $p ; do
    echo -e $x ; ps -o etime -p $x
    echo ""
  done


#  pfx="${prog:0:1}"
#  sfx="${prog:1}"
#  ps aux | grep -v $pid | grep -P '['"$pfx"']'"$sfx" | \
#    sed 's/  */ /g' | \
#    cut -f2 -d' ' | \
#    xargs -n1 -I{} ps -o etime -p {}

fi



